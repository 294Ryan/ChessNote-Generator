<details class="line-card"{% if line.index is not none %} id="line-{{ line.index }}" data-idx="{{ line.index }}"{% endif %}>
    <summary>
        <span class="line-pgn">
            <span class="collapsed"><span class="pgn-mark">&nbsp;<span class="pgn-text">{{ line.pgn }}</span>&nbsp;</span><span class="pgn-dots">.....</span></span>
            <span class="expanded"><span class="pgn-mark">&nbsp;<span class="pgn-text">{{ line.pgn }}</span>&nbsp;</span></span>
        </span>
        <span class="line-toggle"></span>
    </summary>
    {% if line.board is not none %}
    <div class="line-board">
        <div class="cb cb-line" data-own="{{ line.board }}" aria-label="{{ opening.altLine }}"></div>
    </div>
    {% elif line.image %}
    <div class="line-board">
        <img src="{{ line.image }}" alt="{{ opening.altLine }}">
    </div>
    {% endif %}
</details>
