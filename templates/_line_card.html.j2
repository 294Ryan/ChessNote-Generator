<details class="line-card">
    <summary>
        <span class="line-pgn">
            <span class="collapsed"><span class="pgn-mark">&nbsp;{{ line.pgnPreview }}&nbsp;</span></span>
            <span class="expanded"><span class="pgn-mark">&nbsp;{{ line.pgn }}&nbsp;</span></span>
        </span>
        <span class="line-toggle"></span>
    </summary>
    <div class="line-board{% if not line.image %} empty{% endif %}">
        {% if line.image %}<img src="{{ line.image }}" alt="Line 棋盤圖">{% endif %}
    </div>
</details>
