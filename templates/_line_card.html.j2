<details class="line-card">
    <summary>
        <span class="line-name">{{ line.name }}</span>
        <span class="line-toggle"></span>
    </summary>
    <div class="line-pgn">
        <div class="collapsed">{{ line.pgnPreview }}</div>
        <div class="expanded">{{ line.pgn }}</div>
    </div>
    {% if line.description %}<div class="line-desc">{{ line.description }}</div>{% endif %}
    {% if line.image %}
    <div class="line-board">
        <img src="{{ line.image }}" alt="{{ line.name }} 棋盤圖">
    </div>
    {% endif %}
</details>
